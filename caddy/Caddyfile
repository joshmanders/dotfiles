# --------
# Local Certificate Authority
# --------
{
	persist_config off

	pki {
		ca {
			intermediate_lifetime 1800d
		}
	}
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

# Load snippets (tls, client-ip, laravel)
import /opt/homebrew/etc/caddy/snippets/*

# Internal landing page (Concierge Dashboard), not managed by concierge
# The site name "concierge" is reserved for it
concierge.dev.local {
	import dev-tls

	root * /opt/homebrew/etc/caddy/dashboard
	encode zstd gzip
	file_server
}

# Load site configurations
import /opt/homebrew/etc/caddy/sites/*
