# ============================================================================
# Laravel Snippets
# ============================================================================

# Laravel Reverb websocket handler
# Proxies /reverb/* to the Reverb server on port 8081
(reverb) {
	@reverb {
		path /reverb/*
	}

	handle @reverb {
		uri strip_prefix /reverb
		reverse_proxy 127.0.0.1:8081
	}
}

# Laravel Snippet (base)
# Usage: import laravel <name> <path>
(laravel) {
	*.{args[0]}.dev.local, {args[0]}.dev.local {
		import dev-tls

		root * {args[1]}/public
		encode zstd gzip
		file_server
		php_fastcgi 127.0.0.1:9000

		import reverb
	}
}

# Laravel Snippet with IP Forwarding
# Usage: import laravel-ip <name> <path> <ip>
# Use when your app needs the real client IP (rate limiting, geo-location, etc.)
(laravel-ip) {
	*.{args[0]}.dev.local, {args[0]}.dev.local {
		import dev-tls

		root * {args[1]}/public
		encode zstd gzip
		file_server
		php_fastcgi 127.0.0.1:9000 {
			import client-ip {args[2]}
		}

		import reverb
	}
}
