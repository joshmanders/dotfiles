# Note: user.name and user.email are set by git/install.sh from config.sh

[user]
	signingkey = ~/.ssh/id_ed25519.pub
	name = Josh Manders
	email = josh@joshmanders.com
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[push]
	default = simple
	followTags = true
	autoSetupRemote = true
[core]
	excludesfile = ~/.gitignore
	ignorecase = false
	editor = nvim
[http]
	sslVerify = false
[rerere]
	enabled = true
[branch]
	autosetuprebase = always
[help]
	autocorrect = 1
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[init]
	defaultBranch = master
[credential]
	helper = osxkeychain
