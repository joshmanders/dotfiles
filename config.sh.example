#!/usr/bin/env bash
#
# config.sh - Personal configuration
#
# This file is auto-generated by the installer.
# Edit values as needed - this file is gitignored.

# Your name (used in git commits)
export DOTFILES_NAME=

# Your email (used in git commits and SSH key)
export DOTFILES_EMAIL=

# GitHub username (used for scoped gh cli actions)
export DOTFILES_GITHUB_USERNAME=

# Timezone
export DOTFILES_TZ="America/Los_Angeles"

# Editor
export DOTFILES_EDITOR="nvim"

# Disable Homebrew auto-update (1 = disabled)
export DOTFILES_HOMEBREW_NO_AUTOUPDATE="1"

# Shell history size
export DOTFILES_HISTSIZE="50000"

# npm registry auth token
export DOTFILES_NPM_TOKEN=

# GitHub npm package registry auth token
export DOTFILES_GITHUB_NPM_TOKEN=

# Primcloud projects directory
export DOTFILES_PRIMCLOUD_DIR="$HOME/Code/primcloud"
