#!/usr/bin/env bash
#
# cpx - Composer Package Executor
#
# Like npx but for PHP/Composer projects.
# Stops at git repo boundary.
#
# Resolution order:
#   1. vendor/bin/<cmd> (traverses up to repo root)
#   2. php artisan <cmd> (Laravel projects)
#   3. ~/.composer/vendor/bin/<cmd> (global)
#
# Usage:
#   cpx pint          # runs vendor/bin/pint
#   cpx migrate       # runs php artisan migrate (Laravel)
#   cpx pint --dirty  # passes args to the command

set -euo pipefail

if [[ $# -eq 0 ]]; then
    echo "Usage: cpx <command> [args...]"
    exit 1
fi

cmd="$1"
shift

# Find git repo root (our boundary)
repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "cpx: not in a git repository" >&2
    exit 1
}

# Traverse up looking for vendor/bin/<cmd>
dir="$PWD"
while [[ "$dir" == "$repo_root"* ]]; do
    if [[ -x "$dir/vendor/bin/$cmd" ]]; then
        exec "$dir/vendor/bin/$cmd" "$@"
    fi
    [[ "$dir" == "$repo_root" ]] && break
    dir="$(dirname "$dir")"
done

# Laravel project - forward to artisan
if [[ -f "$repo_root/artisan" ]]; then
    exec php "$repo_root/artisan" "$cmd" "$@"
fi

# Fall back to global composer bin
if [[ -x "$HOME/.composer/vendor/bin/$cmd" ]]; then
    exec "$HOME/.composer/vendor/bin/$cmd" "$@"
fi

echo "cpx: no vendor/bin/$cmd found" >&2
exit 1
