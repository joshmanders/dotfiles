#! /usr/bin/env bash
set -euo pipefail

# Merge a GitHub PR locally using rebase strategy
# Requires DOTFILES_GITHUB_USERNAME set and gh auth for that user

function usage() {
  echo "Usage: git merge-pr [-f|--force] <pr-number>"
  echo "  -f, --force  Skip confirmation prompt before push"
  exit 1
}

function main() {
  local force=false
  local id=""

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--force)
        force=true
        shift
        ;;
      -*)
        usage
        ;;
      *)
        id="$1"
        shift
        ;;
    esac
  done

  if [[ -z "$id" ]]; then
    usage
  fi

  # Get repo info (same pattern as git-issue)
  local origin=$(git config --get remote.origin.url)
  local repo=$(echo "${origin}" | sed -E 's/git@github.com:(.*)\.git/\1/' | sed -E 's/https:\/\/github.com\/(.*)\.git/\1/' | sed -E 's/https:\/\/github.com\/(.*)/\1/')

  echo "Fetching PR #${id} from ${repo}..."

  # Fetch PR info via gh api
  local pr=$(GH_TOKEN=$(gh auth token --user "$DOTFILES_GITHUB_USERNAME") gh api "repos/${repo}/pulls/${id}")
  local head_branch=$(echo "${pr}" | jq -r '.head.ref')
  local base_branch=$(echo "${pr}" | jq -r '.base.ref')

  echo "PR branch: ${head_branch}"
  echo "Base branch: ${base_branch}"

  # Checkout and update PR branch
  echo ""
  echo "Checking out PR branch..."
  git fetch origin "${head_branch}"
  git checkout "${head_branch}"
  git pull origin "${head_branch}"

  # Checkout and update base branch
  echo ""
  echo "Checking out base branch..."
  git fetch origin "${base_branch}"
  git checkout "${base_branch}"
  git pull origin "${base_branch}"

  # Rebase PR branch onto base
  echo ""
  echo "Rebasing ${head_branch} onto ${base_branch}..."
  git checkout "${head_branch}"
  if ! git rebase "${base_branch}"; then
    echo ""
    echo "Rebase failed! Resolve conflicts and run:"
    echo "  git rebase --continue"
    echo "Or abort with:"
    echo "  git rebase --abort"
    exit 1
  fi

  # Fast-forward merge into base
  echo ""
  echo "Merging ${head_branch} into ${base_branch}..."
  git checkout "${base_branch}"
  if ! git merge "${head_branch}" --ff-only; then
    echo ""
    echo "Fast-forward merge failed. Base branch may have diverged."
    exit 1
  fi

  # Show what will be pushed
  echo ""
  echo "Commits to push:"
  git log --oneline "origin/${base_branch}..${base_branch}"

  # Confirm or force push
  if [[ "$force" == "false" ]]; then
    echo ""
    read -p "Push to origin/${base_branch}? [y/N] " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      echo "Aborted. Changes are local only."
      exit 0
    fi
  fi

  # Push to origin
  echo ""
  echo "Pushing to origin/${base_branch}..."
  git push origin "${base_branch}"

  # Run git sync for cleanup
  echo ""
  echo "Running git sync..."
  git sync
}

main "$@"
