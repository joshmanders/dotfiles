#!/usr/bin/env bash

set -euo pipefail

# Prevent the wrapper directory from shadowing the real npm binary.
sanitize_path() {
  local cleaned_entries=() entry path_entries=()
  local self_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)

  IFS=':' read -r -a path_entries <<< "${PATH:-}"
  for entry in "${path_entries[@]}"; do
    [[ "$entry" == "$self_dir" ]] && continue
    cleaned_entries+=("$entry")
  done

  if [[ "${#cleaned_entries[@]}" -eq 0 ]]; then
    echo "npm wrapper: unable to find alternate PATH entry" >&2
    return 1
  else
    printf '%s' "${cleaned_entries[0]}"
    for ((i = 1; i < ${#cleaned_entries[@]}; i++)); do
      printf ':%s' "${cleaned_entries[i]}"
    done
  fi
}

main() {
  local sanitized_path=$(sanitize_path) || exit 127
  export PATH="$sanitized_path"

  if [[ -n "${NPM_CMD:-}" ]]; then
    command npm "$@"
    return
  fi

  if [[ "$#" -gt 0 && "$1" == "install" ]]; then
    if [[ "$#" -eq 1 ]]; then
      command npm ci
    else
      command npm "$@"
    fi
  else
    command npm "$@"
  fi
}

main "$@"
