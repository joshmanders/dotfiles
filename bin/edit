#!/usr/bin/env bash

dotfiles () {
  shift
  local args=("$@")
  "${EDITOR}" "${DOTFILES}/${args[@]}"
}

edit () {
  local args=("$@")

  if [ "$#" -gt "0" ]; then
  "${EDITOR}" "${args[@]}"
  else
    "${EDITOR}" .
  fi
}

main () {
  local args=("$@")

  case "$1" in
    dotfiles) dotfiles "${args[@]}" ;;
    caddy) vim /opt/homebrew/etc/sites-enabled/default ;;
    caddyfile) vim /opt/homebrew/etc/Caddyfile ;;
    *) edit "${args[@]}" ;;
  esac
}

main "$@"
