{
  "security.workspace.trust.enabled": false,
  "telemetry.telemetryLevel": "off",
  "editor.fontFamily": "Fira Code",
  "editor.fontLigatures": true,
  "editor.lineHeight": 32,
  "editor.fontSize": 16,
  "editor.formatOnSave": true,
  "editor.showFoldingControls": "always",
  "editor.linkedEditing": true,
  "explorer.confirmDelete": false,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.fontSize": 14,
  "workbench.colorTheme": "GitHub Dark Default",
  "workbench.startupEditor": "none",
  "diffEditor.renderSideBySide": false,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "explorer.confirmDragAndDrop": false,
  "explorer.autoReveal": false,
  "explorer.compactFolders": false,
  "editor.stickyScroll.enabled": false,
  "workbench.tree.enableStickyScroll": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "css.format.spaceAroundSelectorSeparator": true,
  "simpleBrowser.focusLockIndicator.enabled": false,
  "css.validate": false,
  "window.commandCenter": false,
  "update.showReleaseNotes": false,
  "security.promptForLocalFileProtocolHandling": false,
  "task.allowAutomaticTasks": "on",
  "workbench.editor.closeOnFileDelete": true,
  "terminal.integrated.tabs.enabled": false,
  "terminal.integrated.profiles.osx": {
    "bash": {
      "path": "/opt/homebrew/bin/bash",
    },
  },
  "terminal.integrated.defaultProfile.osx": "bash",
  "terminal.integrated.initialHint": false,
  "terminal.integrated.hideOnStartup": "whenEmpty",
  "terminal.integrated.allowedLinkSchemes": [
    "file",
    "http",
    "https",
    "mailto",
    "vscode",
    "vscode-insiders",
    "docker-desktop",
  ],
  "php.inlayHints.parameters.enabled": false,
  "php.inlayHints.types.variable": false,
  "phpTools.suppressPremiumFeatures": true,
  "php.inlayHints.types.return": false,
  "php.format.rules.openBraceOnNewLineForAnonymousClasses": false,
  "php.format.rules.whileStatementNewLineAfterLeftParen": true,
  "[php]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "explorer.autoRevealExclude": {
    "**/vendor": true,
  },
  "editor.quickSuggestions": {
    "strings": "on",
  },
  "npm.exclude": "vendor/**",
  "git.ignoreRebaseWarning": true,
  "extensions.ignoreRecommendations": true,
  "[blade]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "git.openRepositoryInParentFolders": "never",
  "files.associations": {
    "*.astro": "astro",
  },
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode",
  },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
  },
  "git.replaceTagsWhenPull": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "never",
    "source.fixAll.eslint": "always",
  },
  "laravel-pint.enable": true,
  "Laravel.pint.runOnSave": true,
  "Laravel.phpEnvironment": "local",
  "debug.javascript.enableNetworkView": false,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.enabled": false,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "git.showActionButton": {
    "sync": false,
  },
  "claudeCode.preferredLocation": "sidebar",
  "workbench.statusBar.visible": false,
  "workbench.layoutControl.enabled": false,
  "go.toolsManagement.autoUpdate": true,
  "window.nativeTabs": true,
  "window.title": "${folderName}${separator}${activeRepositoryBranchName} ${dirty}",
  "window.customTitleBarVisibility": "never",
  "workbench.activityBar.location": "top",
  "claudeCode.enableNewConversationShortcut": false,
  "testing.resultsView.layout": "treeLeft",
  "claudeCode.initialPermissionMode": "plan",
  "claudeCode.hideOnboarding": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "claudeCode.allowDangerouslySkipPermissions": true,
  "chat.tools.terminal.preventShellHistory": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "Laravel.showErrorPopups": false,
  "claudeCode.selectedModel": "default",
}
