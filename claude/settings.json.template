{
  "respectGitignore": true,
  "cleanupPeriodDays": 30,
  "skillListingBudgetFraction": 0.07,
  "env": {
    "DOTFILES": "${DOTFILES}",
    "BASH_ENV": "${DOTFILES}/bash/bashrc",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "0"
  },
  "attribution": {
    "commit": "Co-Authored-By: Dunnbot <dunnbot@joshmanders.com>",
    "pr": ""
  },
  "includeGitInstructions": true,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-opus-4-8[1m]",
  "enableAllProjectMcpServers": false,
  "disabledMcpjsonServers": [],
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Expedia"
    },
    {
      "serverName": "claude.ai Gmail"
    },
    {
      "serverName": "claude.ai Google Drive"
    },
    {
      "serverName": "claude.ai Google Calendar"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${DOTFILES}/claude/hooks/guard.sh"
          }
        ]
      }
    ]
  },
  "disableAllHooks": false,
  "defaultShell": "bash",
  "outputStyle": "for-josh",
  "spinnerTipsEnabled": false,
  "syntaxHighlightingDisabled": false,
  "terminalTitleFromRename": true,
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "fastMode": false,
  "fastModePerSessionOptIn": false,
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "prefersReducedMotion": false,
  "autoMemoryEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "auto",
  "terminalProgressBarEnabled": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "mcpServers": {}
}
